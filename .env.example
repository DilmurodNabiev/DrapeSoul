# Application
APP_NAME=DrapeSoul
ENV=production
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://drapesoul:drapesoul_secret@db:5432/drapesoul

# Security
SECRET_KEY=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Owner (env-based, cannot be deleted)
OWNER_TELEGRAM_ID=123456789
ORDER_RECEIVER_TELEGRAM_ID=123456789
OWNER_PASSWORD_HASH=

# Payment (shown on checkout for bank transfer)
PAYMENT_CARD_NUMBER=8600 1234 5678 9012
PAYMENT_CARD_HOLDER=DRAPESOUL LLC

# Telegram
BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
WEBAPP_URL=https://shop.yourdomain.com
FRONTEND_URL=https://shop.yourdomain.com
BACKEND_URL=https://api.yourdomain.com

# Storage
STORAGE_BACKEND=local
UPLOAD_DIR=/app/static/uploads/products
CATEGORY_UPLOAD_DIR=/app/static/uploads/categories
RECEIPTS_UPLOAD_DIR=/app/static/uploads/receipts
MAX_UPLOAD_MB=5
PUBLIC_MEDIA_URL=https://api.yourdomain.com/static/uploads/products

# Cloudflare R2 (optional - set STORAGE_BACKEND=r2)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_URL=

# Cloudflare API (optional - cache purge, DNS)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Redis
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ORIGINS=https://shop.yourdomain.com,https://admin.yourdomain.com

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
